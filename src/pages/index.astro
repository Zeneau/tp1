---
import * as Plot from "@observablehq/plot";
import penguins from "../assets/data/penguins.json";
import Layout from '../layouts/Layout.astro';
import PlotFigure from "../components/PlotFigure.astro";
import diamonds from "../assets/data/diamonds.json";
import olympians from "../assets/data/olympians.json";
---

<Layout>
	<PlotFigure options={{
  color: { legend: true },
  facet: { data: penguins, x: "island" },
  marks: [
    Plot.dot(penguins, {
      x: "culmen_length_mm",
      y: "body_mass_g",
      fill: "species",
      r: "flipper_length_mm"
    })
  ]
}}/>

  <PlotFigure options={{
    y: {
      grid: true
    },
    marks: [
      Plot.ruleY([0]),
      Plot.barY(diamonds, {
        x: "carat",
        y: "price",
        sort: { x: "y", reverse: true }
      })
    ]
  }}/>

  <PlotFigure options={{
  color: { legend: true },
  marks: [
    Plot.dot(olympians, {
      x: "height",
      y: "weight",
      fill: "sex",
        r: 3
    })
  ]
}}/>
</Layout>
